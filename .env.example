# Copy to .env and fill in. Never commit real keys.

AI_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
EMBEDDING_PROVIDER=nebius
NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Optional overrides:
# NEBIUS_API_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_TIMEOUT_SECONDS=120

# Explicit development alternatives: EMBEDDING_PROVIDER=local or google.
# Google credentials never automatically enable Google embeddings in Nebius mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-004
USE_VERTEX=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional storage and audit services:
GCS_BUCKET=
GCS_PREFIX=
BQ_DATASET=
USE_FIRESTORE=0
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
USE_SECRET_MANAGER=0

# Change the seeded demo password before exposing a deployment.
KAIROS_ADMIN_EMAIL=admin@kairos.ai
KAIROS_ADMIN_PASSWORD=admin12345

GITHUB_TOKEN=
# Public Research: Search, Map and Extract. Never use private source text as queries.
TAVILY_API_KEY=
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
